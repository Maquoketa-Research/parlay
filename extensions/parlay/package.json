{
  "name": "parlay-ide",
  "displayName": "Parlay",
  "description": "Roblox game development with Claude inside the editor: right-click actions on your code, Script Sync awareness, Aqua and Sonar on the right, three looks (Dark, Paper, Glass).",
  "version": "0.0.5",
  "publisher": "maquoketa",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "enabledApiProposals": [
    "authSessionAccountIcon"
  ],
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./out/extension",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "terminal": {
      "profiles": [
        {
          "id": "parlay.claude",
          "title": "Claude",
          "icon": "sparkle"
        }
      ]
    },
    "commands": [
      {
        "command": "parlay.claude.explain",
        "title": "Explain this",
        "category": "Chat"
      },
      {
        "command": "parlay.claude.fix",
        "title": "Fix this",
        "category": "Chat"
      },
      {
        "command": "parlay.claude.validate",
        "title": "Add server-side validation",
        "category": "Chat"
      },
      {
        "command": "parlay.claude.pcall",
        "title": "Wrap DataStore calls in pcall",
        "category": "Chat"
      },
      {
        "command": "parlay.claude.extract",
        "title": "Extract to ModuleScript",
        "category": "Chat"
      },
      {
        "command": "parlay.claude.test",
        "title": "Write a test",
        "category": "Chat"
      },
      {
        "command": "parlay.claude.ab",
        "title": "Make an A/B variant",
        "category": "Chat"
      },
      {
        "command": "parlay.ask",
        "title": "Ask about the selection\u2026",
        "category": "Chat"
      },
      {
        "command": "parlay.claude.match-assets",
        "title": "Match assets to a Studio screenshot",
        "category": "Parlay"
      },
      {
        "command": "parlay.installSkills",
        "title": "Install Claude skills",
        "category": "Parlay"
      },
      {
        "command": "parlay.claude.insert-asset",
        "title": "Insert a Roblox asset into Studio",
        "category": "Parlay"
      },
      {
        "command": "parlay.meshy.setKey",
        "title": "Set Meshy API key",
        "category": "Parlay"
      },
      {
        "command": "parlay.roblox.setKey",
        "title": "Set Roblox Open Cloud API key",
        "category": "Parlay"
      },
      {
        "command": "parlay.openai.setKey",
        "title": "Set OpenAI API key (concept drafts)",
        "category": "Parlay"
      },
      {
        "command": "parlay.accounts",
        "title": "Accounts",
        "category": "Parlay"
      },
      {
        "command": "parlay.studio.add",
        "title": "Add Roblox Studio project",
        "category": "Parlay"
      },
      {
        "command": "parlay.project.select",
        "title": "Choose game project",
        "category": "Parlay"
      },
      {
        "command": "parlay.scriptSync",
        "title": "Set up Script Sync",
        "category": "Parlay"
      },
      {
        "command": "parlay.studio.open",
        "title": "Open Roblox Studio",
        "category": "Parlay"
      },
      {
        "command": "parlay.roblox.signIn",
        "title": "Sign in to Roblox",
        "category": "Parlay"
      },
      {
        "command": "parlay.roblox.signOut",
        "title": "Sign out of Roblox",
        "category": "Parlay"
      },
      {
        "command": "parlay.discord.signIn",
        "title": "Sign in to Discord",
        "category": "Parlay"
      },
      {
        "command": "parlay.discord.signOut",
        "title": "Sign out of Discord",
        "category": "Parlay"
      },
      {
        "command": "parlay.agents.open",
        "title": "Open agent",
        "category": "Parlay",
        "icon": "$(sparkle)"
      },
      {
        "command": "parlay.agents.useClaude",
        "title": "Continue in Claude",
        "category": "Parlay",
        "icon": "$(sparkle)"
      },
      {
        "command": "parlay.agents.useGpt",
        "title": "Continue in GPT",
        "category": "Parlay",
        "icon": "$(hubot)"
      },
      {
        "command": "parlay.agents.switch",
        "title": "Swap model",
        "category": "Parlay",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "parlay.aqua.show",
        "title": "Open Aqua",
        "category": "Parlay"
      },
      {
        "command": "parlay.aqua.pair",
        "title": "Pair Project with Aqua",
        "category": "Parlay",
        "icon": "$(plug)"
      },
      {
        "command": "parlay.aqua.refresh",
        "title": "Refresh Aqua issues",
        "category": "Parlay",
        "icon": "$(refresh)"
      },
      {
        "command": "parlay.aqua.openInAqua",
        "title": "Open in Aqua",
        "category": "Parlay",
        "icon": "$(link-external)"
      },
      {
        "command": "parlay.aqua.signIn",
        "title": "Sign in to Aqua",
        "category": "Parlay"
      },
      {
        "command": "parlay.aqua.landing",
        "title": "Back to Aqua",
        "category": "Parlay",
        "icon": "$(arrow-left)"
      },
      {
        "command": "parlay.chat.open",
        "title": "Open chat",
        "category": "Parlay",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "parlay.chat.new",
        "title": "New chat",
        "category": "Parlay",
        "icon": "$(add)"
      },
      {
        "command": "parlay.chat.history",
        "title": "Chat: conversation history",
        "category": "Parlay",
        "icon": "$(history)"
      },
      {
        "command": "parlay.chat.useClaude",
        "title": "Chat: continue in Claude",
        "category": "Parlay",
        "icon": "$(sparkle)"
      },
      {
        "command": "parlay.chat.useGpt",
        "title": "Chat: continue in Codex",
        "category": "Parlay",
        "icon": "$(hubot)"
      }
    ],
    "keybindings": [
      {
        "command": "parlay.agents.open",
        "key": "ctrl+alt+a"
      },
      {
        "command": "parlay.agents.switch",
        "key": "ctrl+alt+s"
      }
    ],
    "authentication": [
      {
        "id": "roblox",
        "label": "Roblox"
      },
      {
        "id": "discord",
        "label": "Discord"
      }
    ],
    "submenus": [
      {
        "id": "parlay.claudeMenu",
        "label": "Claude"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "parlay.claudeMenu",
          "group": "0_parlay",
          "when": "editorTextFocus"
        }
      ],
      "parlay.claudeMenu": [
        {
          "command": "parlay.claude.explain",
          "group": "1_understand@1"
        },
        {
          "command": "parlay.ask",
          "group": "1_understand@2"
        },
        {
          "command": "parlay.claude.fix",
          "group": "2_change@1",
          "when": "editorHasSelection"
        },
        {
          "command": "parlay.claude.validate",
          "group": "2_change@2",
          "when": "editorHasSelection"
        },
        {
          "command": "parlay.claude.pcall",
          "group": "2_change@3",
          "when": "editorHasSelection"
        },
        {
          "command": "parlay.claude.extract",
          "group": "2_change@4",
          "when": "editorHasSelection"
        },
        {
          "command": "parlay.claude.test",
          "group": "3_verify@1"
        },
        {
          "command": "parlay.claude.ab",
          "group": "3_verify@2",
          "when": "editorHasSelection"
        },
        {
          "command": "parlay.claude.match-assets",
          "group": "4_studio@1"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "parlay.claudeMenu",
          "group": "1_parlay"
        }
      ],
      "view/title": [
        {
          "command": "parlay.aqua.landing",
          "when": "view == parlay.aqua",
          "group": "navigation@0"
        },
        {
          "command": "parlay.agents.open",
          "when": "view == terminal && !parlay.agentRunning",
          "group": "navigation@1"
        },
        {
          "command": "parlay.agents.switch",
          "when": "view == terminal && parlay.agentRunning",
          "group": "navigation@1"
        },
        {
          "command": "parlay.aqua.pair",
          "when": "view == parlay.aqua",
          "group": "navigation@1"
        },
        {
          "command": "parlay.aqua.refresh",
          "when": "view == parlay.aqua.issues",
          "group": "navigation@1"
        },
        {
          "command": "parlay.aqua.openInAqua",
          "when": "view == parlay.aqua.issues && parlay.aqua.state =~ /^(ok|empty)$/",
          "group": "navigation@2"
        },
        {
          "command": "parlay.aqua.pair",
          "when": "view == parlay.aqua.issues",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "parlay-chat",
          "title": "Chat",
          "icon": "media/chat.svg"
        },
        {
          "id": "parlay-aqua",
          "title": "Aqua",
          "icon": "media/aqua.png"
        },
        {
          "id": "parlay-meshy",
          "title": "Meshy",
          "icon": "media/meshy.svg"
        },
        {
          "id": "parlay-sonar",
          "title": "Sonar",
          "icon": "media/sonar.svg"
        }
      ]
    },
    "views": {
      "parlay-chat": [
        {
          "type": "webview",
          "id": "parlay.chat",
          "name": "Chat"
        }
      ],
      "parlay-aqua": [
        {
          "type": "webview",
          "id": "parlay.aqua",
          "name": "Aqua"
        },
        {
          "id": "parlay.aqua.issues",
          "name": "Issues",
          "visibility": "hidden"
        }
      ],
      "parlay-meshy": [
        {
          "type": "webview",
          "id": "parlay.meshy",
          "name": "Meshy"
        }
      ],
      "parlay-sonar": [
        {
          "type": "webview",
          "id": "parlay.sonar",
          "name": "Sonar"
        }
      ]
    },
    "themes": [
      {
        "label": "Parlay Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/parlay-dark.json"
      },
      {
        "label": "Parlay Glass",
        "uiTheme": "vs-dark",
        "path": "./themes/parlay-glass.json"
      },
      {
        "label": "Parlay Paper",
        "uiTheme": "vs",
        "path": "./themes/parlay-paper.json"
      },
      {
        "label": "Parlay Aqua",
        "uiTheme": "vs-dark",
        "path": "./themes/parlay-aqua.json"
      }
    ],
    "configuration": {
      "title": "Parlay",
      "properties": {
        "parlay.aquaUrl": {
          "type": "string",
          "default": "https://aqua.maquoketa.net",
          "description": "The Aqua Parlay talks to and shows in its panel. A localhost URL means a checkout Parlay can start itself (parlay.aquaRepo)."
        },
        "parlay.sonarUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8801/sonar",
          "description": "Sonar page shown in the Parlay panel."
        },
        "parlay.requireSignIn": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Ask for a Roblox sign-in before Parlay can be used (the sign-in gate over the workbench)."
        },
        "parlay.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to start Claude Code in the agent terminal.",
          "scope": "machine",
          "restricted": true
        },
        "parlay.claudeArgs": {
          "type": "string",
          "default": "--permission-mode acceptEdits",
          "description": "Arguments Claude Code starts with in the agent terminal (the permission mode: acceptEdits, auto, plan, bypassPermissions\u2026)."
        },
        "parlay.codexCommand": {
          "type": "string",
          "default": "codex",
          "description": "Executable used for Codex in Chat and the agent terminal. Parlay also finds common macOS CLI locations and the bundled CLI in an existing Codex desktop installation.",
          "scope": "machine",
          "restricted": true
        },
        "parlay.codexArgs": {
          "type": "string",
          "default": "-a on-request -s workspace-write",
          "description": "Arguments Codex starts with in the agent terminal (approval policy and sandbox; add --no-alt-screen to keep scrollback)."
        },
        "parlay.glass": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Use native macOS vibrancy or Windows 11 acrylic behind Parlay Glass. Follows the selected theme immediately; requires the Parlay build."
        },
        "parlay.aquaRepo": {
          "type": "string",
          "default": "",
          "description": "Folder of the aqua checkout (has pyproject.toml). Used by the Start button in the Aqua panel. Empty: a sibling of the workspace named aqua, or ~/Documents/GitHub/aqua."
        },
        "parlay.robloxClientId": {
          "type": "string",
          "default": "3251110438441385889",
          "description": "Client ID of the Roblox OAuth 2.0 app Parlay signs in as; the default is Parlay's own app. Only change it to use an app you registered yourself (Creator Dashboard \u2192 Open Cloud \u2192 OAuth 2.0 Apps) for Parlay: Sign in to Roblox. Register both redirect URLs http://localhost:53682/callback and http://localhost:53683/callback. Empty: the sign-in command walks you through the setup."
        },
        "parlay.discordClientId": {
          "type": "string",
          "default": "",
          "description": "Client ID of the Discord application Parlay signs in as (Discord Developer Portal \u2192 Applications \u2192 OAuth2) for Parlay: Sign in to Discord. Register both redirect URLs http://localhost:53682/callback and http://localhost:53683/callback. Empty: the sign-in command walks you through the setup."
        },
        "parlay.robloxCreatorId": {
          "type": "string",
          "default": "",
          "description": "Roblox user id or group id that owns uploaded Meshy models (Open Cloud creationContext)."
        },
        "parlay.robloxCreatorType": {
          "type": "string",
          "enum": [
            "user",
            "group"
          ],
          "default": "user",
          "description": "Whether parlay.robloxCreatorId is a user or a group."
        },
        "parlay.assetsDir": {
          "type": "string",
          "default": "assets/meshy",
          "description": "Folder inside the workspace where Meshy downloads land."
        },
        "parlay.meshyPolycount": {
          "type": "number",
          "default": 20000,
          "description": "Triangle cap for the Meshy mesh (remeshed to this count). Roblox MeshParts want about 20000 or fewer."
        },
        "parlay.stackedHeader": {
          "type": "boolean",
          "default": true,
          "description": "Two-row header: project actions below the title on macOS, and an in-window menu row on Windows and Linux. A change applies at once."
        },
        "parlay.roundedChrome": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Use rounded panels, inset surfaces, and pill-shaped tabs and buttons. Turn off for the classic flat editor layout."
        },
        "parlay.imageModel": {
          "type": "string",
          "default": "gpt-image-2.5-sunburst",
          "description": "OpenAI image model for the concept drafts and for painting the six views of the mesh (gpt-image-2.5-sunburst for precision, gpt-image-2.5-flare for speed, or gpt-image-1)."
        },
        "parlay.referenceDir": {
          "type": "string",
          "default": "assets/reference",
          "description": "Folder inside the workspace with screenshots of the game; drafts match their look. A Studio capture is added when the Studio MCP is free."
        },
        "parlay.projectsDir": {
          "type": "string",
          "default": "",
          "description": "Where Add Roblox Studio project makes folders for places Studio is not syncing yet. Empty: ~/Documents/Parlay."
        },
        "parlay.githubOrg": {
          "type": "string",
          "default": "Maquoketa-Research",
          "description": "GitHub owner whose repos Add Roblox Studio project looks for (a repo named after the place is cloned; otherwise git init points origin at it)."
        },
        "parlay.claude.model": {
          "type": "string",
          "default": "",
          "description": "Model ID or alias. Empty uses the agent default.",
          "scope": "window"
        },
        "parlay.claude.effort": {
          "type": "string",
          "default": "",
          "description": "Thinking effort. Empty uses the model default.",
          "scope": "window"
        },
        "parlay.claude.fast": {
          "type": "boolean",
          "default": false,
          "description": "Request fast mode. Uses additional quota when supported by the model and account.",
          "scope": "window"
        },
        "parlay.codex.model": {
          "type": "string",
          "default": "",
          "description": "Model ID or alias. Empty uses the agent default.",
          "scope": "window"
        },
        "parlay.codex.effort": {
          "type": "string",
          "default": "",
          "description": "Thinking effort. Empty uses the model default.",
          "scope": "window"
        },
        "parlay.codex.fast": {
          "type": "boolean",
          "default": false,
          "description": "Request fast mode. Uses additional quota when supported by the model and account.",
          "scope": "window"
        }
      }
    },
    "configurationDefaults": {
      "workbench.colorTheme": "Parlay Dark",
      "window.title": "${dirty}${activeEditorShort}${separator}${rootName}",
      "editor.fontFamily": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
      "editor.fontSize": 13,
      "editor.lineHeight": 1.65,
      "files.associations": {
        "*.luau": "luau"
      },
      "parlay.glass": false,
      "workbench.activityBar.location": "bottom",
      "window.commandCenter": false,
      "workbench.layoutControl.enabled": false,
      "editor.minimap.enabled": false,
      "editor.renderLineHighlight": "gutter",
      "editor.scrollBeyondLastLine": false,
      "editor.cursorBlinking": "smooth",
      "workbench.tree.indent": 14,
      "workbench.editor.tabSizing": "shrink",
      "workbench.startupEditor": "none",
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "window.titleSeparator": "  \u00b7  ",
      "parlay.stackedHeader": true,
      "luau-lsp.sourcemap.autogenerate": false,
      "luau-lsp.plugin.enabled": true
    },
    "viewsWelcome": [
      {
        "view": "workbench.explorer.emptyView",
        "contents": "Parlay works on the folder Roblox Studio syncs a place to. Pick an open Studio and Parlay finds or makes that folder, wires git and opens it.\n[Add Roblox Studio project](command:parlay.studio.add)\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "parlay.aqua.issues",
        "contents": "Asking Aqua\u2026",
        "when": "parlay.aqua.state == loading"
      },
      {
        "view": "parlay.aqua.issues",
        "contents": "Open your game's Script Sync folder to see its Aqua issues and work on its scripts.\n[Open Game Folder](command:workbench.action.files.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "parlay.aqua.issues",
        "contents": "Connect this game's place using the pairing page below. Its issues will appear here.",
        "when": "parlay.aqua.state == noGame && workbenchState != empty"
      },
      {
        "view": "parlay.aqua.issues",
        "contents": "Aqua is not answering. A local Aqua can be started from the panel below; otherwise check the connection or the parlay.aquaUrl setting.\n[Retry](command:parlay.aqua.refresh)",
        "when": "parlay.aqua.state == unreachable"
      },
      {
        "view": "parlay.aqua.issues",
        "contents": "Sign in to Aqua to load this game's issues. You can also open the dashboard below.\n[Sign in to Aqua](command:parlay.aqua.signIn)",
        "when": "parlay.aqua.state == signIn"
      },
      {
        "view": "parlay.aqua.issues",
        "contents": "No open issues. Aqua lists them here as players report them and servers hit them.\n[Open in Aqua](command:parlay.aqua.openInAqua)",
        "when": "parlay.aqua.state == empty"
      }
    ]
  },
  "scripts": {
    "compile": "gulp compile-extension:parlay-ide",
    "watch": "gulp watch-extension:parlay-ide",
    "check": "node tools/check.mjs && node --no-warnings tools/sourcemap-check.mjs && node --no-warnings tools/studio-discovery-check.mjs && node --no-warnings tools/mac-studio-sync-check.mjs && node --no-warnings tools/handoff-check.mjs && node --no-warnings tools/rbxmx-check.mjs && node --no-warnings tools/aqua-check.mjs && node --no-warnings tools/aqua-pairing-check.mjs && node --no-warnings tools/aqua-identity-check.mjs && node --no-warnings tools/chat-check.mjs && node --no-warnings tools/chat-view-check.mjs && node --no-warnings tools/agent-options-check.mjs"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "three": "0.186.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Parlay works on the folders it makes; nothing in it needs a trusted workspace."
    },
    "virtualWorkspaces": false
  }
}
