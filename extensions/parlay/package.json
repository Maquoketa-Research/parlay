{
  "name": "parlay-ide",
  "displayName": "Parlay",
  "description": "Roblox game development with Claude inside the editor: right-click actions on your code, Script Sync awareness, Aqua and Sonar on the right, three looks (Dark, Paper, Glass).",
  "version": "0.0.5",
  "publisher": "maquoketa",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./out/extension",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "parlay.claude.explain",
        "title": "Explain this",
        "category": "Claude"
      },
      {
        "command": "parlay.claude.fix",
        "title": "Fix this",
        "category": "Claude"
      },
      {
        "command": "parlay.claude.validate",
        "title": "Add server-side validation",
        "category": "Claude"
      },
      {
        "command": "parlay.claude.pcall",
        "title": "Wrap DataStore calls in pcall",
        "category": "Claude"
      },
      {
        "command": "parlay.claude.extract",
        "title": "Extract to ModuleScript",
        "category": "Claude"
      },
      {
        "command": "parlay.claude.test",
        "title": "Write a test",
        "category": "Claude"
      },
      {
        "command": "parlay.claude.ab",
        "title": "Make an A/B variant",
        "category": "Claude"
      },
      {
        "command": "parlay.ask",
        "title": "Ask about the selection…",
        "category": "Claude"
      },
      {
        "command": "parlay.claude.match-assets",
        "title": "Match assets to a Studio screenshot",
        "category": "Parlay"
      },
      {
        "command": "parlay.installSkills",
        "title": "Install Claude skills",
        "category": "Parlay"
      },
      {
        "command": "parlay.claude.insert-asset",
        "title": "Insert a Roblox asset into Studio",
        "category": "Parlay"
      },
      {
        "command": "parlay.meshy.setKey",
        "title": "Set Meshy API key",
        "category": "Parlay"
      },
      {
        "command": "parlay.roblox.setKey",
        "title": "Set Roblox Open Cloud API key",
        "category": "Parlay"
      },
      {
        "command": "parlay.openai.setKey",
        "title": "Set OpenAI API key (concept drafts)",
        "category": "Parlay"
      },
      {
        "command": "parlay.studio.add",
        "title": "Add Roblox Studio project",
        "category": "Parlay"
      }
    ],
    "submenus": [
      {
        "id": "parlay.claudeMenu",
        "label": "Claude"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "parlay.claudeMenu",
          "group": "0_parlay",
          "when": "editorTextFocus"
        }
      ],
      "parlay.claudeMenu": [
        {
          "command": "parlay.claude.explain",
          "group": "1_understand@1"
        },
        {
          "command": "parlay.ask",
          "group": "1_understand@2"
        },
        {
          "command": "parlay.claude.fix",
          "group": "2_change@1",
          "when": "editorHasSelection"
        },
        {
          "command": "parlay.claude.validate",
          "group": "2_change@2",
          "when": "editorHasSelection"
        },
        {
          "command": "parlay.claude.pcall",
          "group": "2_change@3",
          "when": "editorHasSelection"
        },
        {
          "command": "parlay.claude.extract",
          "group": "2_change@4",
          "when": "editorHasSelection"
        },
        {
          "command": "parlay.claude.test",
          "group": "3_verify@1"
        },
        {
          "command": "parlay.claude.ab",
          "group": "3_verify@2",
          "when": "editorHasSelection"
        },
        {
          "command": "parlay.claude.match-assets",
          "group": "4_studio@1"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "parlay.claudeMenu",
          "group": "1_parlay"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "parlay-aqua",
          "title": "Aqua",
          "icon": "media/aqua.svg"
        },
        {
          "id": "parlay-meshy",
          "title": "Meshy",
          "icon": "media/meshy.svg"
        },
        {
          "id": "parlay-sonar",
          "title": "Sonar",
          "icon": "media/sonar.svg"
        }
      ]
    },
    "views": {
      "parlay-aqua": [
        {
          "type": "webview",
          "id": "parlay.aqua",
          "name": "Aqua"
        }
      ],
      "parlay-meshy": [
        {
          "type": "webview",
          "id": "parlay.meshy",
          "name": "Meshy"
        }
      ],
      "parlay-sonar": [
        {
          "type": "webview",
          "id": "parlay.sonar",
          "name": "Sonar"
        }
      ]
    },
    "themes": [
      {
        "label": "Parlay Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/parlay-dark.json"
      },
      {
        "label": "Parlay Glass",
        "uiTheme": "vs-dark",
        "path": "./themes/parlay-glass.json"
      },
      {
        "label": "Parlay Paper",
        "uiTheme": "vs",
        "path": "./themes/parlay-paper.json"
      },
      {
        "label": "Parlay Aqua",
        "uiTheme": "vs-dark",
        "path": "./themes/parlay-aqua.json"
      }
    ],
    "configuration": {
      "title": "Parlay",
      "properties": {
        "parlay.aquaUrl": {
          "type": "string",
          "default": "http://localhost:8787",
          "description": "Aqua dashboard shown in the Parlay panel."
        },
        "parlay.sonarUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8801/sonar",
          "description": "Sonar page shown in the Parlay panel."
        },
        "parlay.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to start Claude Code in the terminal."
        },
        "parlay.glass": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Draw the window over Windows 11 acrylic so the Parlay Glass theme is real glass. Set automatically when that theme is chosen; applies to windows opened afterwards. Needs the Parlay build."
        },
        "parlay.aquaRepo": {
          "type": "string",
          "default": "",
          "description": "Folder of the aqua checkout (has pyproject.toml). Used by the Start button in the Aqua panel. Empty: a sibling of the workspace named aqua, or ~/Documents/GitHub/aqua."
        },
        "parlay.robloxCreatorId": {
          "type": "string",
          "default": "",
          "description": "Roblox user id or group id that owns uploaded Meshy models (Open Cloud creationContext)."
        },
        "parlay.robloxCreatorType": {
          "type": "string",
          "enum": [
            "user",
            "group"
          ],
          "default": "user",
          "description": "Whether parlay.robloxCreatorId is a user or a group."
        },
        "parlay.assetsDir": {
          "type": "string",
          "default": "assets/meshy",
          "description": "Folder inside the workspace where Meshy downloads land."
        },
        "parlay.meshyPolycount": {
          "type": "number",
          "default": 20000,
          "description": "Triangle cap for the Meshy mesh (remeshed to this count). Roblox MeshParts want about 20000 or fewer."
        },
        "parlay.stackedHeader": {
          "type": "boolean",
          "default": true,
          "description": "Two-row header: the mark and Parlay above the menu bar. On by default in Parlay; a change applies at once."
        },
        "parlay.imageModel": {
          "type": "string",
          "default": "gpt-image-2.5-sunburst",
          "description": "OpenAI image model for the concept drafts and for painting the six views of the mesh (gpt-image-2.5-sunburst for precision, gpt-image-2.5-flare for speed, or gpt-image-1)."
        },
        "parlay.referenceDir": {
          "type": "string",
          "default": "assets/reference",
          "description": "Folder inside the workspace with screenshots of the game; drafts match their look. A Studio capture is added when the Studio MCP is free."
        },
        "parlay.projectsDir": {
          "type": "string",
          "default": "",
          "description": "Where Add Roblox Studio project makes folders for places Studio is not syncing yet. Empty: ~/Documents/Parlay."
        },
        "parlay.githubOrg": {
          "type": "string",
          "default": "Maquoketa-Research",
          "description": "GitHub owner whose repos Add Roblox Studio project looks for (a repo named after the place is cloned; otherwise git init points origin at it)."
        }
      }
    },
    "configurationDefaults": {
      "workbench.colorTheme": "Parlay Dark",
      "window.title": "${dirty}${activeEditorShort}${separator}${rootName}",
      "editor.fontFamily": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
      "editor.fontSize": 13,
      "editor.lineHeight": 1.65,
      "files.associations": {
        "*.luau": "luau"
      },
      "parlay.glass": false,
      "workbench.activityBar.location": "bottom",
      "window.commandCenter": false,
      "workbench.layoutControl.enabled": false,
      "editor.minimap.enabled": false,
      "editor.renderLineHighlight": "gutter",
      "editor.scrollBeyondLastLine": false,
      "editor.cursorBlinking": "smooth",
      "workbench.tree.indent": 14,
      "workbench.editor.tabSizing": "shrink",
      "workbench.startupEditor": "none",
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "window.titleSeparator": "  ·  ",
      "parlay.stackedHeader": true,
      "luau-lsp.sourcemap.autogenerate": false
    },
    "viewsWelcome": [
      {
        "view": "workbench.explorer.emptyView",
        "contents": "Parlay works on the folder Roblox Studio syncs a place to. Pick an open Studio and Parlay finds or makes that folder, wires git and opens it.\n[Add Roblox Studio project](command:parlay.studio.add)\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workbenchState == empty"
      }
    ]
  },
  "scripts": {
    "compile": "gulp compile-extension:parlay-ide",
    "watch": "gulp watch-extension:parlay-ide",
    "check": "node tools/check.mjs"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "three": "0.186.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Parlay works on the folders it makes; nothing in it needs a trusted workspace."
    },
    "virtualWorkspaces": false
  }
}
