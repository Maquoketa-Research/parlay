{
  "name": "drydock-ide",
  "displayName": "Drydock IDE",
  "description": "Roblox game development with Claude inside the editor: right-click actions on your code, Script Sync awareness, Aqua and Sonar on the right, three looks (Dark, Paper, Glass).",
  "version": "0.0.5",
  "publisher": "maquoketa",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./out/extension",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "drydock.claude.explain",
        "title": "Explain this",
        "category": "Claude"
      },
      {
        "command": "drydock.claude.fix",
        "title": "Fix this",
        "category": "Claude"
      },
      {
        "command": "drydock.claude.validate",
        "title": "Add server-side validation",
        "category": "Claude"
      },
      {
        "command": "drydock.claude.pcall",
        "title": "Wrap DataStore calls in pcall",
        "category": "Claude"
      },
      {
        "command": "drydock.claude.extract",
        "title": "Extract to ModuleScript",
        "category": "Claude"
      },
      {
        "command": "drydock.claude.test",
        "title": "Write a test",
        "category": "Claude"
      },
      {
        "command": "drydock.claude.ab",
        "title": "Make an A/B variant",
        "category": "Claude"
      },
      {
        "command": "drydock.ask",
        "title": "Ask about the selection…",
        "category": "Claude"
      },
      {
        "command": "drydock.claude.match-assets",
        "title": "Match assets to a Studio screenshot",
        "category": "Drydock"
      },
      {
        "command": "drydock.installSkills",
        "title": "Install Claude skills",
        "category": "Drydock"
      },
      {
        "command": "drydock.claude.insert-asset",
        "title": "Insert a Roblox asset into Studio",
        "category": "Drydock"
      },
      {
        "command": "drydock.meshy.setKey",
        "title": "Set Meshy API key",
        "category": "Drydock"
      },
      {
        "command": "drydock.roblox.setKey",
        "title": "Set Roblox Open Cloud API key",
        "category": "Drydock"
      },
      {
        "command": "drydock.openai.setKey",
        "title": "Set OpenAI API key (concept drafts)",
        "category": "Drydock"
      }
    ],
    "submenus": [
      {
        "id": "drydock.claudeMenu",
        "label": "Claude"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "drydock.claudeMenu",
          "group": "0_drydock",
          "when": "editorTextFocus"
        }
      ],
      "drydock.claudeMenu": [
        {
          "command": "drydock.claude.explain",
          "group": "1_understand@1"
        },
        {
          "command": "drydock.ask",
          "group": "1_understand@2"
        },
        {
          "command": "drydock.claude.fix",
          "group": "2_change@1",
          "when": "editorHasSelection"
        },
        {
          "command": "drydock.claude.validate",
          "group": "2_change@2",
          "when": "editorHasSelection"
        },
        {
          "command": "drydock.claude.pcall",
          "group": "2_change@3",
          "when": "editorHasSelection"
        },
        {
          "command": "drydock.claude.extract",
          "group": "2_change@4",
          "when": "editorHasSelection"
        },
        {
          "command": "drydock.claude.test",
          "group": "3_verify@1"
        },
        {
          "command": "drydock.claude.ab",
          "group": "3_verify@2",
          "when": "editorHasSelection"
        },
        {
          "command": "drydock.claude.match-assets",
          "group": "4_studio@1"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "drydock.claudeMenu",
          "group": "1_drydock"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "drydock-aqua",
          "title": "Aqua",
          "icon": "media/aqua.svg"
        },
        {
          "id": "drydock-meshy",
          "title": "Meshy",
          "icon": "media/meshy.svg"
        },
        {
          "id": "drydock-sonar",
          "title": "Sonar",
          "icon": "media/sonar.svg"
        }
      ]
    },
    "views": {
      "drydock-aqua": [
        {
          "type": "webview",
          "id": "drydock.aqua",
          "name": "Aqua"
        }
      ],
      "drydock-meshy": [
        {
          "type": "webview",
          "id": "drydock.meshy",
          "name": "Meshy"
        }
      ],
      "drydock-sonar": [
        {
          "type": "webview",
          "id": "drydock.sonar",
          "name": "Sonar"
        }
      ]
    },
    "themes": [
      {
        "label": "Drydock Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/drydock-dark.json"
      },
      {
        "label": "Drydock Glass",
        "uiTheme": "vs-dark",
        "path": "./themes/drydock-glass.json"
      },
      {
        "label": "Drydock Paper",
        "uiTheme": "vs",
        "path": "./themes/drydock-paper.json"
      },
      {
        "label": "Drydock Aqua",
        "uiTheme": "vs-dark",
        "path": "./themes/drydock-aqua.json"
      }
    ],
    "configuration": {
      "title": "Drydock",
      "properties": {
        "drydock.aquaUrl": {
          "type": "string",
          "default": "http://localhost:8787",
          "description": "Aqua dashboard shown in the Drydock panel."
        },
        "drydock.sonarUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8801/sonar",
          "description": "Sonar page shown in the Drydock panel."
        },
        "drydock.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to start Claude Code in the terminal."
        },
        "drydock.glass": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Draw the window over Windows 11 acrylic so the Drydock Glass theme is real glass. Set automatically when that theme is chosen; applies to windows opened afterwards. Needs the Drydock IDE build."
        },
        "drydock.aquaRepo": {
          "type": "string",
          "default": "",
          "description": "Folder of the aqua checkout (has pyproject.toml). Used by the Start button in the Aqua panel. Empty: a sibling of the workspace named aqua, or ~/Documents/GitHub/aqua."
        },
        "drydock.robloxCreatorId": {
          "type": "string",
          "default": "",
          "description": "Roblox user id or group id that owns uploaded Meshy models (Open Cloud creationContext)."
        },
        "drydock.robloxCreatorType": {
          "type": "string",
          "enum": [
            "user",
            "group"
          ],
          "default": "user",
          "description": "Whether drydock.robloxCreatorId is a user or a group."
        },
        "drydock.assetsDir": {
          "type": "string",
          "default": "assets/meshy",
          "description": "Folder inside the workspace where Meshy downloads land."
        },
        "drydock.meshyPolycount": {
          "type": "number",
          "default": 20000,
          "description": "Triangle cap for the Meshy mesh (remeshed to this count). Roblox MeshParts want about 20000 or fewer."
        },
        "drydock.stackedHeader": {
          "type": "boolean",
          "default": true,
          "description": "Two-row header: the mark and Drydock IDE above the menu bar. Needs the Drydock IDE build; a change applies to new windows."
        },
        "drydock.imageModel": {
          "type": "string",
          "default": "gpt-image-2.5-sunburst",
          "description": "OpenAI image model for the concept drafts and for painting the six views of the mesh (gpt-image-2.5-sunburst for precision, gpt-image-2.5-flare for speed, or gpt-image-1)."
        },
        "drydock.referenceDir": {
          "type": "string",
          "default": "assets/reference",
          "description": "Folder inside the workspace with screenshots of the game; drafts match their look. A Studio capture is added when the Studio MCP is free."
        }
      }
    },
    "configurationDefaults": {
      "workbench.colorTheme": "Drydock Dark",
      "window.title": "${dirty}${activeEditorShort}${separator}${rootName}",
      "editor.fontFamily": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
      "editor.fontSize": 13,
      "editor.lineHeight": 1.65,
      "files.associations": {
        "*.luau": "luau"
      },
      "drydock.glass": false,
      "workbench.activityBar.location": "bottom",
      "window.commandCenter": false,
      "workbench.layoutControl.enabled": false,
      "editor.minimap.enabled": false,
      "editor.renderLineHighlight": "gutter",
      "editor.scrollBeyondLastLine": false,
      "editor.cursorBlinking": "smooth",
      "workbench.tree.indent": 14,
      "workbench.editor.tabSizing": "shrink",
      "workbench.startupEditor": "none",
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "window.titleSeparator": "  ·  ",
      "drydock.stackedHeader": true,
      "luau-lsp.sourcemap.autogenerate": false
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:drydock-ide",
    "watch": "gulp watch-extension:drydock-ide",
    "check": "node tools/check.mjs"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "three": "0.186.0"
  }
}
