 "tokenColors": [
  {
   "scope": [
    "keyword",
    "keyword.control",
    "storage.type",
    "storage.modifier",
    "keyword.operator.logical"
   ],
   "settings": {
    "foreground": "#C9BFD6"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.interpolated"
   ],
   "settings": {
    "foreground": "#B9C9A8"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call entity.name.function"
   ],
   "settings": {
    "foreground": "#F9F9F9"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language"
   ],
   "settings": {
    "foreground": "#E8B27A"
   }
  },
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#7E7883",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "variable",
    "variable.other",
    "punctuation",
    "keyword.operator"
   ],
   "settings": {
    "foreground": "#E6E2E7"
   }
  },
  {
   "scope": [
    "support.type",
    "entity.name.type",
    "storage.type.luau"
   ],
   "settings": {
    "foreground": "#D8C4B0"
   }
  }
 ]
