 "tokenColors": [
  {
   "scope": [
    "keyword",
    "keyword.control",
    "storage.type",
    "storage.modifier",
    "keyword.operator.logical"
   ],
   "settings": {
    "foreground": "#9FB3C8"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.interpolated"
   ],
   "settings": {
    "foreground": "#A3B99A"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call entity.name.function"
   ],
   "settings": {
    "foreground": "#E6E8EB"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language"
   ],
   "settings": {
    "foreground": "#C9B27C"
   }
  },
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#7B8290",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "variable",
    "variable.other",
    "punctuation",
    "keyword.operator"
   ],
   "settings": {
    "foreground": "#D7DAE0"
   }
  },
  {
   "scope": [
    "support.type",
    "entity.name.type",
    "storage.type.luau"
   ],
   "settings": {
    "foreground": "#B3A3C8"
   }
  }
 ]
